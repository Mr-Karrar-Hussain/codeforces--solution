#include <iostream>
using namespace std;
int main() {
    // Write C++ code here
 
  int n=4;
  long long arr[n];
  for(int i=0; i<n; i++){
  cin>>arr[i];
  }
   int count=0;
  for(int i=0; i<n-1; i++){
    for(int j=i+1; j<n; j++){
      if(arr[i]==arr[j]){
          count++;
          break;
      }
    }
  }
  cout<<count;
    return 0;
}